---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>We have a problem</title>
		<style>
			:root {
				--bg: #000000;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				background-color: var(--bg);
				color: #e8eaed;
				font-family: Georgia, "Times New Roman", serif;
			}

			.title {
				position: relative;
				z-index: 1;
				margin: 60px 1rem 0;
				text-align: center;
				font-size: clamp(1.75rem, 4vw + 1rem, 3rem);
				font-weight: 700;
				line-height: 1.2;
			}

			.hero-image {
				position: fixed;
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				width: 100%;
				height: auto;
				max-height: 100vh;
				object-fit: contain;
				display: block;
				pointer-events: none;
			}

			@media (max-width: 640px) {
				.title {
					margin-top: 60px;
					font-size: clamp(1.5rem, 6vw + 0.5rem, 2.25rem);
				}
			}
		</style>
	</head>
	<body>
		<h1 class="title">We have a problem</h1>
		<img
			class="hero-image"
			src="/images/main-image.png"
			alt=""
		/>
	</body>
</html>
