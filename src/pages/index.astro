---

const tickerSegment = "FOR PREVIEW ONLY · ";
const tickerLine = tickerSegment.repeat(24);

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Jaag Punjab | A state of crisis fueled by a drug epidemic</title>
		<style>
			@font-face {
				font-family: "Anton SC";
				src: url("/fonts/Anton_SC/AntonSC-Regular.ttf") format("truetype");
				font-weight: 400;
				font-style: normal;
				font-display: swap;
			}

			:root {
				--bg: #000000;
				/* Hero art 3000×2628; opaque desk band is ~706px tall from the bottom. */
				--hero-w: 3000;
				--hero-h: 2628;
				--hero-band: 706;
				--hero-render-height: min(100vw * var(--hero-h) / var(--hero-w), 90vh);
				--band-visible: calc(var(--hero-render-height) * var(--hero-band) / var(--hero-h));
				--below-fold: 100dvh;
				/*
				 * Syringe placement as fractions of the hero stage.
				 * Tuned from ~140×180×140 on a ~1400px-wide hero.
				 */
				--syringe-width: 17%;
				--syringe-right: 13%;
				--syringe-bottom: 18%;
				--preview-ticker-height: 2rem;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				overscroll-behavior-y: none;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				background-color: var(--bg);
				color: #e8eaed;
				font-family: Georgia, "Times New Roman", serif;
			}

			.preview-ticker {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 200;
				overflow: hidden;
				height: var(--preview-ticker-height);
				background-color: #000000;
				color: #ffffff;
				pointer-events: none;
			}

			.preview-ticker__track {
				display: flex;
				width: max-content;
				will-change: transform;
				animation: preview-ticker-scroll 28s linear infinite;
			}

			.preview-ticker__group {
				flex: 0 0 auto;
				padding-right: 0;
				font-family: "Anton SC", sans-serif;
				font-size: 0.85rem;
				font-weight: 400;
				line-height: var(--preview-ticker-height);
				letter-spacing: 0.2em;
				text-transform: uppercase;
				white-space: nowrap;
			}

			@keyframes preview-ticker-scroll {
				from {
					transform: translate3d(0, 0, 0);
				}

				to {
					transform: translate3d(-50%, 0, 0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.preview-ticker__track {
					animation: none;
					margin: 0 auto;
				}

				.preview-ticker__group:last-child {
					display: none;
				}
			}

			/*
			 * Isolates the scroll story so later sections don't steal the
			 * free space that margin-top: auto needs for the first-viewport pin.
			 */
			.story {
				display: flex;
				flex-direction: column;
				min-height: calc(100dvh + var(--below-fold));
			}

			.title-container {
				position: relative;
				z-index: 100;
				max-width: 450px;
				margin: 60px auto 0;
				padding: 0 1rem;
				text-align: left;
			}

			.title {
				margin: 0;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(3.5rem, 8vw + 2rem, 6rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ff0000;
			}

			.reveal-title-container {
				position: fixed;
				inset: 0;
				z-index: 5;
				display: flex;
				align-items: center;
				justify-content: flex-start;
				padding: 0 1rem 0 0;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.45s ease;
			}

			.reveal-title-container.is-visible {
				opacity: 1;
			}

			.reveal-title {
				margin: 0;
				margin-left: 50%;
				max-width: 450px;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(1.5rem, 6vw + 2rem, 4rem);
				font-weight: 400;
				line-height: 0.9;
				color: #000000;
				text-align: left;
			}

			.reveal-title sup {
				font-size: 0.45em;
			}

			.reveal-title sup a {
				color: inherit;
				text-decoration: none;
				pointer-events: auto;
			}

			/* Generic scroll-fade utility (opacity only) */
			.scroll-fade {
				opacity: 0;
				transition: opacity 0.45s ease;
				will-change: opacity;
				pointer-events: none;
			}

			.scroll-fade.is-visible {
				opacity: 1;
				pointer-events: auto;
			}

			/* Full-bleed fixed layer; art lives in the centered stage. */
			.hero-stack {
				position: fixed;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				display: flex;
				justify-content: center;
				align-items: flex-end;
				pointer-events: none;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			.hero-stack--front {
				z-index: 3;
				opacity: 1;
			}

			/*
			 * Single source of truth for hero size.
			 * Width-capped by viewport; height-capped at 90vh via max-height + aspect-ratio.
			 */
			.hero-stage {
				position: relative;
				width: min(100vw, calc(90vh * var(--hero-w) / var(--hero-h)));
				max-height: 90vh;
				aspect-ratio: var(--hero-w) / var(--hero-h);
			}

			.hero-art {
				position: absolute;
				inset: 0;
				display: block;
				width: 100%;
				height: 100%;
				object-fit: fill;
			}

			.hero-art--fast {
				z-index: 1;
				opacity: var(--hero-opacity-fast, 1);
				will-change: opacity;
			}

			.hero-art--mid {
				z-index: 2;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			/* Invisible rest slot — used to aim the active translate at the viewport. */
			.hero-syringe-anchor {
				position: absolute;
				right: var(--syringe-right);
				bottom: var(--syringe-bottom);
				width: var(--syringe-width);
				aspect-ratio: 1146 / 219;
				visibility: hidden;
				pointer-events: none;
			}

			/* Same stage coordinate space as the art — always stays locked. */
			.hero-syringe {
				position: absolute;
				right: var(--syringe-right);
				bottom: var(--syringe-bottom);
				z-index: 4;
				width: var(--syringe-width);
				--syringe-dx: 0px;
				--syringe-dy: 0px;
				transform: translate(0px, 0px) rotate(0deg) scale(1);
				/* Pivot on the needle (left end). */
				transform-origin: 60% 0%;
				transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
				will-change: transform;
			}

			.hero-syringe.is-active {
				transform: translate(var(--syringe-dx), var(--syringe-dy)) rotate(142deg) scale(8);
			}

			.hero-syringe-img {
				display: block;
				width: 100%;
				height: auto;
			}

			/* Needle tip — left end, vertically centered on the asset. */
			.hero-syringe-drip {
				position: absolute;
				left: 0;
				top: 60%;
				width: 0;
				height: 0;
				pointer-events: none;
				rotate: 232deg;
				--drip-cycle: 3.9s;
				/* Nudge fall vs bead; positive = fall starts later. */
				--drip-fall-delay: 0s;
				/* Fall motion speed reference (36% of this ≈ 0.94s of travel). */
				--drip-fall-motion: 2.6s;
			}

			.hero-syringe-drip::before,
			.hero-syringe-drip::after {
				content: "";
				position: absolute;
				left: 0;
				top: 0;
				background: #000000;
				border-radius: 50%;
				transform: translate(-50%, -50%);
			}

			/* Bead forming at the needle tip. */
			.hero-syringe-drip::before {
				width: 5px;
				height: 7px;
				border-radius: 50% 50% 50% 50% / 35% 35% 65% 65%;
				opacity: 0;
				animation: none;
			}

			/* Detached drop falling away. */
			.hero-syringe-drip::after {
				width: 4px;
				height: 5px;
				opacity: 0;
				animation: none;
			}

			.hero-syringe.is-dripping .hero-syringe-drip::before {
				animation: syringe-drip-bead var(--drip-cycle) ease-out infinite;
			}

			.hero-syringe.is-dripping .hero-syringe-drip::after {
				/*
				 * Matches bead loop length; delay offsets fall after bead detach.
				 * Fall motion keeps 2.6s speed (64%–88% of the cycle).
				 */
				animation: syringe-drip-fall var(--drip-cycle) ease-in var(--drip-fall-delay)
					infinite;
			}

			@keyframes syringe-drip-bead {
				0%,
				8% {
					opacity: 0;
					transform: translate(-50%, -50%) scale(0.4);
				}

				18%,
				52% {
					opacity: 1;
					transform: translate(-50%, -50%) scale(1);
				}

				58% {
					opacity: 1;
					transform: translate(-50%, -40%) scale(1.15, 1.25);
				}

				64%,
				100% {
					opacity: 0;
					transform: translate(-50%, -50%) scale(0.2);
				}
			}

			@keyframes syringe-drip-fall {
				0%,
				64% {
					opacity: 0;
					transform: translate(-50%, -30%) scale(1);
				}

				64.01% {
					opacity: 1;
					transform: translate(-50%, -30%) scale(1);
				}

				76% {
					opacity: 0.75;
					transform: translate(-50%, calc(-30% + 2.8em)) scale(0.95, 1.1);
				}

				88%,
				100% {
					opacity: 0;
					transform: translate(-50%, calc(-30% + 4.5em)) scale(0.85, 1.2);
				}
			}

			.bottom-section {
				position: relative;
				z-index: 2;
				margin-top: auto;
				width: 100%;
				min-height: calc(var(--band-visible) + var(--below-fold));
				background-color: #ff0000;
			}

			.after-section {
				position: relative;
				z-index: 6;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: start;
				gap: 1.5rem;
				width: 100%;
				min-height: 100dvh;
				padding: 4rem 1rem;
				background-color: #ffffff;
				text-align: center;
			}

			.site-footer {
				width: 100%;
				margin: 0;
				background-color: #ffffff;
				text-align: right;
			}

			.site-footer p {
				margin: 0;
				padding: 0 0.5rem 0.5rem;
				font-family: Verdana, Geneva, sans-serif;
				font-size: 0.75rem;
				color: #a8a8a8;
			}

			.after-title-block {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.after-title {
				margin: 0;
				max-width: 450px;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(1.5rem, 4vw + 2rem, 3rem);
				font-weight: 400;
				line-height: 0.9;
				color: #000000;
			}

			.after-section > .after-title {
				font-size: clamp(1.2rem, 3.2vw + 1.6rem, 2.4rem);
			}

			.after-cta {
				margin: 0;
				padding: 0.65em 1.25em;
				border: none;
				border-radius: 4px;
				background-color: #ff0000;
				color: #ffffff;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(0.75rem, 2vw + 1rem, 1.5rem);
				font-weight: 700;
				line-height: 0.9;
				cursor: pointer;
				-webkit-tap-highlight-color: transparent;
			}

			.after-cta__swiper {
				display: block;
				overflow: hidden;
				height: 1.1em;
			}

			.after-cta__track {
				display: block;
				transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
			}

			.after-cta__label {
				display: block;
				letter-spacing: 0.05em;
				line-height: 1.2;
			}

			.after-cta:hover .after-cta__track,
			.after-cta:focus-visible .after-cta__track {
				transform: translateY(-50%);
			}

			.after-cta-anchor {
				position: relative;
				display: inline-block;
			}

			.after-cta-hint {
				position: absolute;
				left: calc(100% + 1.25rem);
				top: 50%;
				margin: 0;
				width: max-content;
				max-width: min(6rem, 40rem);
				transform: translateY(-10%);
				pointer-events: none;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				font-family: Verdana, Geneva, sans-serif;
				font-size: clamp(0.85rem, 1.2vw + 0.55rem, 1.05rem);
				font-style: italic;
				line-height: 1.25;
				color: #7e7e7e;
			}

			.after-cta-hint__text {
				display: block;
				animation: cta-hint-jump 1.6s ease-in-out infinite;
			}

			.after-cta-hint__arrow {
				display: block;
				width: 3.75rem;
				height: auto;
				margin: 0 0 0.3rem;
				overflow: visible;
				transform: translateX(-70%);
			}

			@keyframes cta-hint-jump {
				0%,
				100% {
					transform: translateY(0);
				}
				30% {
					transform: translateY(-0.45em);
				}
				50% {
					transform: translateY(0);
				}
				70% {
					transform: translateY(-0.2em);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.after-cta__track {
					transition: none;
				}

				.after-cta-hint {
					animation: none;
				}

				.after-cta-hint__text {
					animation: none;
				}
			}

			.after-video {
				width: min(100%, 720px);
				aspect-ratio: 16 / 9;
				border-radius: 4px;
				overflow: hidden; /* ensures iframe corners are clipped */
			}

			.after-video iframe {
				display: block;
				width: 100%;
				height: 100%;
				border: 0;
				border-radius: 4px;
			}

			.white-text-section {
				position: relative;
				z-index: 7; /* Above fixed hero layers */
				background: #000000;
				color: #ffffff;
				height: 100vh;
				padding: 2rem 1rem;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				font-family: Georgia, "Times New Roman", serif;
			}

			.white-text {
				margin: 0;
				max-width: 900px;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(1.5rem, 6vw + 2rem, 4rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ffffff;
				text-align: center;
			}

			@media (max-width: 1040px) {
				.title,
				.reveal-title {
					font-size: clamp(2.4rem, 9.6vw + 0.8rem, 3.6rem);
				}

				.white-text {
					font-size: clamp(1.2rem, 4.8vw + 1.6rem, 3.2rem);
				}

				.after-title {
					font-size: clamp(1.2rem, 3.2vw + 1.6rem, 2.4rem);
				}

				.after-section > .after-title {
					font-size: clamp(0.96rem, 2.56vw + 1.28rem, 1.92rem);
				}

				.after-cta {
					font-size: clamp(0.6rem, 1.6vw + 0.8rem, 1.2rem);
				}

				.reveal-title-container {
					align-items: flex-start;
					justify-content: center;
					padding: 200px 100px 0;
				}

				.reveal-title {
					margin-left: 0;
					max-width: none;
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<div class="preview-ticker" role="marquee" aria-label="For preview only">
			<div class="preview-ticker__track">
				<span class="preview-ticker__group">{tickerLine}</span>
				<span class="preview-ticker__group" aria-hidden="true">{tickerLine}</span>
			</div>
		</div>
		<div class="story">
			<div class="title-container">
				<h1 class="title">we have a problem</h1>
			</div>
			<div class="reveal-title-container" aria-hidden="true">
				<p class="reveal-title">7 out of 10 college-going students are into drug abuse in Punjab<sup><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5787955/" target="_blank" rel="noopener noreferrer">[1]</a></sup></p>
			</div>
			<div class="hero-stack hero-stack--back">
				<div class="hero-stage">
					<img class="hero-art" src="images/l01.png" alt="" />
				</div>
			</div>
			<section class="bottom-section" aria-hidden="true"></section>
			<div class="hero-stack hero-stack--front">
				<div class="hero-stage">
					<img class="hero-art hero-art--fast" src="images/l02.png" alt="" />
					<img class="hero-art hero-art--mid" src="images/l03.png" alt="" />
					<div class="hero-syringe-anchor" aria-hidden="true"></div>
					<div class="hero-syringe">
						<img class="hero-syringe-img" src="images/l04.png" alt="" />
						<span class="hero-syringe-drip" aria-hidden="true"></span>
					</div>
				</div>
			</div>
		</div>
		<section class="white-text-section">
			<p class="white-text">it's a system perpetuated by <br />failures of the state, <br/>cross-border narco-terrorism and a disillusioned youth</p>
		</section>

		<section class="after-section">
			<h2 class="after-title scroll-fade" aria-hidden="true">
				HEAR THE STORIES OF LIVES AFFECTED BY THIS VICE
			</h2>
			<div class="after-video scroll-fade" aria-hidden="true">
				<iframe
					src="https://www.youtube.com/embed/g9Gn7R7XKfw"
					title="YouTube video"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
			<div class="after-title-block scroll-fade" aria-hidden="true">
				<h2 class="after-title">we still have hope...</h2>
				<div class="after-cta-anchor">
					<button class="after-cta" type="button" aria-label="ਜਾਗ ਪੰਜਾਬ — WAKE UP PUNJAB">
						<span class="after-cta__swiper">
							<span class="after-cta__track">
								<span class="after-cta__label">ਜਾਗ ਪੰਜਾਬ</span>
								<span class="after-cta__label">WAKE UP PUNJAB</span>
							</span>
						</span>
					</button>
					<p class="after-cta-hint">
						<svg
							class="after-cta-hint__arrow"
							viewBox="0 0 64 32"
							aria-hidden="true"
							fill="none"
						>
							<defs>
								<marker
									id="after-cta-hint-arrowhead"
									markerWidth="7"
									markerHeight="7"
									refX="6"
									refY="3.5"
									orient="auto"
									markerUnits="strokeWidth"
								>
									<path
										d="M0,0 L6,3.5 L0,7"
										stroke="currentColor"
										stroke-width="1.2"
										stroke-linecap="round"
										stroke-linejoin="round"
									></path>
								</marker>
							</defs>
							<path
								d="M 58 26 C 44 10, 24 6, 8 14"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-dasharray="3.5 3"
								stroke-linecap="round"
								stroke-linejoin="round"
								marker-end="url(#after-cta-hint-arrowhead)"
							></path>
						</svg>
						<span class="after-cta-hint__text">Click to show your support</span>
					</p>
				</div>
			</div>
		</section>
		<footer class="site-footer">
			<p>Designed and developed by O-LAP Designs</p>
		</footer>
		<script>
			const bottomSection = document.querySelector(".bottom-section");
			const syringe = document.querySelector(".hero-syringe");
			const syringeAnchor = document.querySelector(".hero-syringe-anchor");
			const revealTitle = document.querySelector(".reveal-title-container");
			const scrollFadeElements = document.querySelectorAll(".scroll-fade");
			const root = document.documentElement;
			const SYRINGE_TRIGGER_PX = 300;

			function updateHeroFade(top: number) {
				// Fully visible until the red band climbs into the upper half,
				// then fade to 0 as its top edge reaches the top of the page.
				const fadeStart = window.innerHeight * 0.5;
				const opacity = Math.min(1, Math.max(0, top / fadeStart));
				// l02 fades twice as fast — gone when the others are halfway.
				const opacityFast = Math.min(1, Math.max(0, 2 * opacity - 1));
				root.style.setProperty("--hero-opacity", String(opacity));
				root.style.setProperty("--hero-opacity-fast", String(opacityFast));
			}

			function updateSyringeTravel() {
				if (!(syringe instanceof HTMLElement)) return;
				if (!(syringeAnchor instanceof HTMLElement)) return;

				const rect = syringeAnchor.getBoundingClientRect();
				// Needle sits on the left end of the asset.
				const needleX = rect.left;
				const needleY = rect.top + rect.height / 2;
				const targetX = 0;
				const targetY = window.innerHeight;

				syringe.style.setProperty("--syringe-dx", `${targetX - needleX}px`);
				syringe.style.setProperty("--syringe-dy", `${targetY - needleY}px`);
			}

			function setRevealVisible(visible: boolean) {
				if (!(revealTitle instanceof HTMLElement)) return;
				revealTitle.classList.toggle("is-visible", visible);
				revealTitle.setAttribute("aria-hidden", visible ? "false" : "true");
			}

			function setScrollFadeVisible(element: Element, visible: boolean) {
				if (!(element instanceof HTMLElement)) return;
				element.classList.toggle("is-visible", visible);
				element.setAttribute("aria-hidden", visible ? "false" : "true");
			}

			function setDripping(active: boolean) {
				if (!(syringe instanceof HTMLElement)) return;
				syringe.classList.toggle("is-dripping", active);
			}

			function updateSyringe(top: number) {
				if (!(syringe instanceof HTMLElement)) return;
				updateSyringeTravel();
				const shouldActive = top <= SYRINGE_TRIGGER_PX;
				const wasActive = syringe.classList.contains("is-active");
				syringe.classList.toggle("is-active", shouldActive);
				// Hide as soon as the reverse trip starts.
				if (wasActive && !shouldActive) {
					setRevealVisible(false);
					setDripping(false);
				}
			}

			function updateOnScrollOrResize() {
				if (!(bottomSection instanceof HTMLElement)) return;
				const { top } = bottomSection.getBoundingClientRect();
				updateHeroFade(top);
				updateSyringe(top);
			}

			let ticking = false;
			function onScrollOrResize() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateOnScrollOrResize();
					ticking = false;
				});
			}

			if (syringe instanceof HTMLElement) {
				syringe.addEventListener("transitionend", (event) => {
					if (!(event instanceof TransitionEvent)) return;
					if (event.propertyName !== "transform") return;
					if (event.target !== syringe) return;
					if (syringe.classList.contains("is-active")) {
						setRevealVisible(true);
						setDripping(true);
					}
				});
			}

			updateOnScrollOrResize();
			window.addEventListener("scroll", onScrollOrResize, { passive: true });
			window.addEventListener("resize", onScrollOrResize);

			function initSmoothScroll() {
				const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
				if (reducedMotion.matches) return;

				let current = window.scrollY;
				let target = window.scrollY;
				let lastTime = 0;
				let raf = 0;
				// Lower = longer coast after the wheel stops.
				const lambda = 4;

				function maxScroll() {
					return Math.max(
						0,
						document.documentElement.scrollHeight - window.innerHeight,
					);
				}

				function clamp(value: number) {
					return Math.max(0, Math.min(value, maxScroll()));
				}

				function start(time = performance.now()) {
					if (raf) return;
					lastTime = time;
					raf = requestAnimationFrame(tick);
				}

				function tick(now: number) {
					const dt = Math.min(64, now - lastTime);
					lastTime = now;
					target = clamp(target);
					const alpha = 1 - Math.exp((-lambda * dt) / 1000);
					current += (target - current) * alpha;

					if (Math.abs(target - current) < 0.15) {
						current = target;
						window.scrollTo(0, current);
						raf = 0;
						return;
					}

					window.scrollTo(0, current);
					raf = requestAnimationFrame(tick);
				}

				function onWheel(event: WheelEvent) {
					if (event.ctrlKey) return;
					event.preventDefault();

					let delta = event.deltaY;
					if (event.deltaMode === 1) delta *= 16;
					else if (event.deltaMode === 2) delta *= window.innerHeight;

					target = clamp(target + delta);
					start();
				}

				function onNativeScroll() {
					const y = window.scrollY;
					if (Math.abs(y - current) < 2) return;
					current = y;
					target = y;
				}

				window.addEventListener("wheel", onWheel, { passive: false });
				window.addEventListener("scroll", onNativeScroll, { passive: true });
			}

			initSmoothScroll();

			// Reveal `.scroll-fade` elements when they enter the viewport.
			(function initScrollFade() {
				if (!scrollFadeElements.length) return;

				const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
				if (reducedMotion.matches) {
					scrollFadeElements.forEach((el) => setScrollFadeVisible(el, true));
					return;
				}

				if (typeof IntersectionObserver === "undefined") {
					const onScroll = () => {
						const viewportH = window.innerHeight;
						scrollFadeElements.forEach((el) => {
							if (!(el instanceof HTMLElement)) return;
							const rect = el.getBoundingClientRect();
							const visible =
								rect.top < viewportH * 0.85 && rect.bottom > viewportH * 0.15;
							setScrollFadeVisible(el, visible);
						});
					};
					onScroll();
					window.addEventListener("scroll", onScroll, { passive: true });
					window.addEventListener("resize", onScroll);
					return;
				}

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							setScrollFadeVisible(entry.target, true);
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.15 },
				);

				scrollFadeElements.forEach((el) => observer.observe(el));
			})();

			const afterCta = document.querySelector(".after-cta");

			async function sharePage() {
				const shareData = {
					title: document.title,
					text: "ਜਾਗ ਪੰਜਾਬ — WAKE UP PUNJAB",
					url: window.location.href,
				};

				if (typeof navigator.share === "function") {
					try {
						if (!navigator.canShare || navigator.canShare(shareData)) {
							await navigator.share(shareData);
							return;
						}
					} catch (error) {
						if (error instanceof DOMException && error.name === "AbortError") {
							return;
						}
					}
				}

				const message = encodeURIComponent(`${shareData.text}\n${shareData.url}`);
				window.open(`https://wa.me/?text=${message}`, "_blank", "noopener,noreferrer");
			}

			if (afterCta instanceof HTMLButtonElement) {
				afterCta.addEventListener("click", () => {
					void sharePage();
				});
			}
		</script>
	</body>
</html>
