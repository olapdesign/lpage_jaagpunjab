---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>We have a problem</title>
		<style>
			@font-face {
				font-family: "Anton SC";
				src: url("/fonts/Anton_SC/AntonSC-Regular.ttf") format("truetype");
				font-weight: 400;
				font-style: normal;
				font-display: swap;
			}

			:root {
				--bg: #000000;
				/* Hero art 3000×2628; opaque desk band is ~706px tall from the bottom. */
				--hero-render-height: min(100vw * 2628 / 3000, 90vh);
				--band-visible: calc(var(--hero-render-height) * 706 / 2628);
				--below-fold: 100dvh;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				display: flex;
				flex-direction: column;
				/* Extra length matches .bottom-section so margin-top: auto
				   keeps the same first-viewport pin while red continues below. */
				min-height: calc(100dvh + var(--below-fold));
				background-color: var(--bg);
				color: #e8eaed;
				font-family: Georgia, "Times New Roman", serif;
			}

			.title-container {
				position: relative;
				z-index: 1;
				max-width: 450px;
				margin: 60px auto 0;
				padding: 0 1rem;
				text-align: center;
			}

			.title {
				margin: 0;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(3.5rem, 8vw + 2rem, 6rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ff0000;
			}

			.hero-stack {
				position: fixed;
				left: 0;
				right: 0;
				bottom: 0;
				width: 100%;
				max-height: 90vh;
				pointer-events: none;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			.hero-stack--back {
				z-index: 1;
			}

			.hero-stack--front {
				z-index: 3;
				opacity: 1;
			}

			.hero-stack img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 90vh;
				object-fit: contain;
				object-position: bottom center;
			}

			.hero-stack--front img:nth-child(1) {
				position: relative;
				z-index: 1;
				opacity: var(--hero-opacity-fast, 1);
				will-change: opacity;
			}

			.hero-stack--front img:nth-child(2) {
				position: absolute;
				left: 0;
				bottom: 0;
				z-index: 2;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			.bottom-section {
				position: relative;
				z-index: 2;
				margin-top: auto;
				width: 100%;
				/* Visible peek tracks hero width; + below-fold keeps scroll room. */
				min-height: calc(var(--band-visible) + var(--below-fold));
				background-color: #ff0000;
			}

			@media (max-width: 640px) {
				.title {
					font-size: clamp(3rem, 12vw + 1rem, 4.5rem);
				}
			}
		</style>
	</head>
	<body>
		<div class="title-container">
			<h1 class="title">we have a problem</h1>
		</div>
		<div class="hero-stack hero-stack--back">
			<img src="images/l01.png" alt="" />
		</div>
		<section class="bottom-section" aria-hidden="true"></section>
		<div class="hero-stack hero-stack--front">
			<img src="images/l02.png" alt="" />
			<img src="images/l03.png" alt="" />
		</div>
		<script>
			const bottomSection = document.querySelector(".bottom-section");
			const root = document.documentElement;

			function updateHeroFade() {
				if (!(bottomSection instanceof HTMLElement)) return;

				const { top } = bottomSection.getBoundingClientRect();
				// Fully visible until the red band climbs into the upper half,
				// then fade to 0 as its top edge reaches the top of the page.
				const fadeStart = window.innerHeight * 0.5;
				const opacity = Math.min(1, Math.max(0, top / fadeStart));
				// l02 fades twice as fast — gone when the others are halfway.
				const opacityFast = Math.min(1, Math.max(0, 2 * opacity - 1));
				root.style.setProperty("--hero-opacity", String(opacity));
				root.style.setProperty("--hero-opacity-fast", String(opacityFast));
			}

			let ticking = false;
			function onScrollOrResize() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateHeroFade();
					ticking = false;
				});
			}

			updateHeroFade();
			window.addEventListener("scroll", onScrollOrResize, { passive: true });
			window.addEventListener("resize", onScrollOrResize);
		</script>
	</body>
</html>
