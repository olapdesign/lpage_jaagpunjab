<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>We have a problem</title>
		<style>
			@font-face {
				font-family: "Anton SC";
				src: url("/fonts/Anton_SC/AntonSC-Regular.ttf") format("truetype");
				font-weight: 400;
				font-style: normal;
				font-display: swap;
			}

			:root {
				--bg: #000000;
				/* Hero art 3000×2628; opaque desk band is ~706px tall from the bottom. */
				--hero-w: 3000;
				--hero-h: 2628;
				--hero-band: 706;
				--hero-render-height: min(100vw * var(--hero-h) / var(--hero-w), 90vh);
				--band-visible: calc(var(--hero-render-height) * var(--hero-band) / var(--hero-h));
				--below-fold: 100dvh;
				/*
				 * Syringe placement as fractions of the hero stage.
				 * Tuned from ~140×180×140 on a ~1400px-wide hero.
				 */
				--syringe-width: 17%;
				--syringe-right: 13%;
				--syringe-bottom: 18%;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				background-color: var(--bg);
				color: #e8eaed;
				font-family: Georgia, "Times New Roman", serif;
			}

			/*
			 * Isolates the scroll story so later sections don't steal the
			 * free space that margin-top: auto needs for the first-viewport pin.
			 */
			.story {
				display: flex;
				flex-direction: column;
				min-height: calc(100dvh + var(--below-fold));
			}

			.title-container {
				position: relative;
				z-index: 100;
				max-width: 450px;
				margin: 60px auto 0;
				padding: 0 1rem;
				text-align: left;
			}

			.title {
				margin: 0;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(3.5rem, 8vw + 2rem, 6rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ff0000;
			}

			.reveal-title-container {
				position: fixed;
				inset: 0;
				z-index: 5;
				display: flex;
				align-items: center;
				justify-content: flex-start;
				padding: 0 1rem 0 0;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.45s ease;
			}

			.reveal-title-container.is-visible {
				opacity: 1;
			}

			.reveal-title {
				margin: 0;
				margin-left: 50%;
				max-width: 450px;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(1.5rem, 6vw + 2rem, 4rem);
				font-weight: 400;
				line-height: 0.9;
				color: #000000;
				text-align: left;
			}

			.reveal-title sup {
				font-size: 0.45em;
			}

			.reveal-title sup a {
				color: inherit;
				text-decoration: none;
				pointer-events: auto;
			}

			/* Full-bleed fixed layer; art lives in the centered stage. */
			.hero-stack {
				position: fixed;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				display: flex;
				justify-content: center;
				align-items: flex-end;
				pointer-events: none;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			.hero-stack--front {
				z-index: 3;
				opacity: 1;
			}

			/*
			 * Single source of truth for hero size.
			 * Width-capped by viewport; height-capped at 90vh via max-height + aspect-ratio.
			 */
			.hero-stage {
				position: relative;
				width: min(100vw, calc(90vh * var(--hero-w) / var(--hero-h)));
				max-height: 90vh;
				aspect-ratio: var(--hero-w) / var(--hero-h);
			}

			.hero-art {
				position: absolute;
				inset: 0;
				display: block;
				width: 100%;
				height: 100%;
				object-fit: fill;
			}

			.hero-art--fast {
				z-index: 1;
				opacity: var(--hero-opacity-fast, 1);
				will-change: opacity;
			}

			.hero-art--mid {
				z-index: 2;
				opacity: var(--hero-opacity, 1);
				will-change: opacity;
			}

			/* Invisible rest slot — used to aim the active translate at the viewport. */
			.hero-syringe-anchor {
				position: absolute;
				right: var(--syringe-right);
				bottom: var(--syringe-bottom);
				width: var(--syringe-width);
				aspect-ratio: 1146 / 219;
				visibility: hidden;
				pointer-events: none;
			}

			/* Same stage coordinate space as the art — always stays locked. */
			.hero-syringe {
				position: absolute;
				right: var(--syringe-right);
				bottom: var(--syringe-bottom);
				z-index: 4;
				width: var(--syringe-width);
				--syringe-dx: 0px;
				--syringe-dy: 0px;
				transform: translate(0px, 0px) rotate(0deg) scale(1);
				/* Pivot on the needle (left end). */
				transform-origin: 60% 0%;
				transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
				will-change: transform;
			}

			.hero-syringe.is-active {
				transform: translate(var(--syringe-dx), var(--syringe-dy)) rotate(142deg) scale(8);
			}

			.hero-syringe-img {
				display: block;
				width: 100%;
				height: auto;
			}

			/* Needle tip — left end, vertically centered on the asset. */
			.hero-syringe-drip {
				position: absolute;
				left: 0;
				top: 60%;
				width: 0;
				height: 0;
				pointer-events: none;
				rotate: 232deg;
				--drip-cycle: 3.9s;
				/* Nudge fall vs bead; positive = fall starts later. */
				--drip-fall-delay: 0s;
				/* Fall motion speed reference (36% of this ≈ 0.94s of travel). */
				--drip-fall-motion: 2.6s;
			}

			.hero-syringe-drip::before,
			.hero-syringe-drip::after {
				content: "";
				position: absolute;
				left: 0;
				top: 0;
				background: #000000;
				border-radius: 50%;
				transform: translate(-50%, -50%);
			}

			/* Bead forming at the needle tip. */
			.hero-syringe-drip::before {
				width: 5px;
				height: 7px;
				border-radius: 50% 50% 50% 50% / 35% 35% 65% 65%;
				opacity: 0;
				animation: none;
			}

			/* Detached drop falling away. */
			.hero-syringe-drip::after {
				width: 4px;
				height: 5px;
				opacity: 0;
				animation: none;
			}

			.hero-syringe.is-dripping .hero-syringe-drip::before {
				animation: syringe-drip-bead var(--drip-cycle) ease-out infinite;
			}

			.hero-syringe.is-dripping .hero-syringe-drip::after {
				/*
				 * Matches bead loop length; delay offsets fall after bead detach.
				 * Fall motion keeps 2.6s speed (64%–88% of the cycle).
				 */
				animation: syringe-drip-fall var(--drip-cycle) ease-in var(--drip-fall-delay)
					infinite;
			}

			@keyframes syringe-drip-bead {
				0%,
				8% {
					opacity: 0;
					transform: translate(-50%, -50%) scale(0.4);
				}

				18%,
				52% {
					opacity: 1;
					transform: translate(-50%, -50%) scale(1);
				}

				58% {
					opacity: 1;
					transform: translate(-50%, -40%) scale(1.15, 1.25);
				}

				64%,
				100% {
					opacity: 0;
					transform: translate(-50%, -50%) scale(0.2);
				}
			}

			@keyframes syringe-drip-fall {
				0%,
				64% {
					opacity: 0;
					transform: translate(-50%, -30%) scale(1);
				}

				64.01% {
					opacity: 1;
					transform: translate(-50%, -30%) scale(1);
				}

				76% {
					opacity: 0.75;
					transform: translate(-50%, calc(-30% + 2.8em)) scale(0.95, 1.1);
				}

				88%,
				100% {
					opacity: 0;
					transform: translate(-50%, calc(-30% + 4.5em)) scale(0.85, 1.2);
				}
			}

			.bottom-section {
				position: relative;
				z-index: 2;
				margin-top: auto;
				width: 100%;
				/* Visible peek tracks hero width; + below-fold keeps scroll room. */
				min-height: calc(var(--band-visible) + var(--below-fold));
				background-color: #ff0000;
			}

			.after-section {
				position: relative;
				/* Above fixed hero layers so black cleanly replaces the scroll story. */
				z-index: 6;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: start;
				gap: 2.5rem;
				width: 100%;
				min-height: 100dvh;
				padding: 7rem 1rem;
				background-color: #000000;
				text-align: center;
			}

			.after-title {
				margin: 0;
				max-width: 450px;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(1.5rem, 4vw + 2rem, 3rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ffffff;
			}

			.after-video {
				width: min(100%, 720px);
				aspect-ratio: 16 / 9;
			}

			.after-video iframe {
				display: block;
				width: 100%;
				height: 100%;
				border: 0;
			}

			@media (max-width: 1040px) {
				.title,
				.reveal-title {
					font-size: clamp(3rem, 12vw + 1rem, 4.5rem);
				}

				.reveal-title-container {
					align-items: flex-start;
					justify-content: center;
					padding: 200px 100px 0;
				}

				.reveal-title {
					margin-left: 0;
					max-width: none;
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<div class="story">
			<div class="title-container">
				<h1 class="title">we have a problem</h1>
			</div>
			<div class="reveal-title-container" aria-hidden="true">
				<p class="reveal-title">7 out of 10 college-going students are into drug abuse in Punjab<sup><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5787955/" target="_blank" rel="noopener noreferrer">[1]</a></sup></p>
			</div>
			<div class="hero-stack hero-stack--back">
				<div class="hero-stage">
					<img class="hero-art" src="images/l01.png" alt="" />
				</div>
			</div>
			<section class="bottom-section" aria-hidden="true"></section>
			<div class="hero-stack hero-stack--front">
				<div class="hero-stage">
					<img class="hero-art hero-art--fast" src="images/l02.png" alt="" />
					<img class="hero-art hero-art--mid" src="images/l03.png" alt="" />
					<div class="hero-syringe-anchor" aria-hidden="true"></div>
					<div class="hero-syringe">
						<img class="hero-syringe-img" src="images/l04.png" alt="" />
						<span class="hero-syringe-drip" aria-hidden="true"></span>
					</div>
				</div>
			</div>
		</div>
		<section class="after-section">
			<h2 class="after-title">we still have hope</h2>
			<div class="after-video">
				<iframe
					src="https://www.youtube.com/embed/g9Gn7R7XKfw"
					title="YouTube video"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
		</section>
		<script>
			const bottomSection = document.querySelector(".bottom-section");
			const syringe = document.querySelector(".hero-syringe");
			const syringeAnchor = document.querySelector(".hero-syringe-anchor");
			const revealTitle = document.querySelector(".reveal-title-container");
			const root = document.documentElement;
			const SYRINGE_TRIGGER_PX = 300;

			function updateHeroFade(top: number) {
				// Fully visible until the red band climbs into the upper half,
				// then fade to 0 as its top edge reaches the top of the page.
				const fadeStart = window.innerHeight * 0.5;
				const opacity = Math.min(1, Math.max(0, top / fadeStart));
				// l02 fades twice as fast — gone when the others are halfway.
				const opacityFast = Math.min(1, Math.max(0, 2 * opacity - 1));
				root.style.setProperty("--hero-opacity", String(opacity));
				root.style.setProperty("--hero-opacity-fast", String(opacityFast));
			}

			function updateSyringeTravel() {
				if (!(syringe instanceof HTMLElement)) return;
				if (!(syringeAnchor instanceof HTMLElement)) return;

				const rect = syringeAnchor.getBoundingClientRect();
				// Needle sits on the left end of the asset.
				const needleX = rect.left;
				const needleY = rect.top + rect.height / 2;
				const targetX = 0;
				const targetY = window.innerHeight;

				syringe.style.setProperty("--syringe-dx", `${targetX - needleX}px`);
				syringe.style.setProperty("--syringe-dy", `${targetY - needleY}px`);
			}

			function setRevealVisible(visible: boolean) {
				if (!(revealTitle instanceof HTMLElement)) return;
				revealTitle.classList.toggle("is-visible", visible);
				revealTitle.setAttribute("aria-hidden", visible ? "false" : "true");
			}

			function setDripping(active: boolean) {
				if (!(syringe instanceof HTMLElement)) return;
				syringe.classList.toggle("is-dripping", active);
			}

			function updateSyringe(top: number) {
				if (!(syringe instanceof HTMLElement)) return;
				updateSyringeTravel();
				const shouldActive = top <= SYRINGE_TRIGGER_PX;
				const wasActive = syringe.classList.contains("is-active");
				syringe.classList.toggle("is-active", shouldActive);
				// Hide as soon as the reverse trip starts.
				if (wasActive && !shouldActive) {
					setRevealVisible(false);
					setDripping(false);
				}
			}

			function updateOnScrollOrResize() {
				if (!(bottomSection instanceof HTMLElement)) return;
				const { top } = bottomSection.getBoundingClientRect();
				updateHeroFade(top);
				updateSyringe(top);
			}

			let ticking = false;
			function onScrollOrResize() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateOnScrollOrResize();
					ticking = false;
				});
			}

			if (syringe instanceof HTMLElement) {
				syringe.addEventListener("transitionend", (event) => {
					if (!(event instanceof TransitionEvent)) return;
					if (event.propertyName !== "transform") return;
					if (event.target !== syringe) return;
					if (syringe.classList.contains("is-active")) {
						setRevealVisible(true);
						setDripping(true);
					}
				});
			}

			updateOnScrollOrResize();
			window.addEventListener("scroll", onScrollOrResize, { passive: true });
			window.addEventListener("resize", onScrollOrResize);
		</script>
	</body>
</html>
