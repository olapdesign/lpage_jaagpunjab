---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>We have a problem</title>
		<style>
			@font-face {
				font-family: "Anton SC";
				src: url("/fonts/Anton_SC/AntonSC-Regular.ttf") format("truetype");
				font-weight: 400;
				font-style: normal;
				font-display: swap;
			}

			:root {
				--bg: #000000;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				display: flex;
				flex-direction: column;
				min-height: 100dvh;
				background-color: var(--bg);
				color: #e8eaed;
				font-family: Georgia, "Times New Roman", serif;
			}

			.title-container {
				position: relative;
				z-index: 1;
				max-width: 450px;
				margin: 60px auto 0;
				padding: 0 1rem;
				text-align: center;
			}

			.title {
				margin: 0;
				font-family: "Anton SC", sans-serif;
				font-size: clamp(3.5rem, 8vw + 2rem, 6rem);
				font-weight: 400;
				line-height: 0.9;
				color: #ff0000;
			}

			.hero-stack {
				position: fixed;
				left: 0;
				right: 0;
				bottom: 0;
				width: 100%;
				max-height: 90vh;
				pointer-events: none;
				z-index: 0;
			}

			.hero-stack img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 90vh;
				object-fit: contain;
				object-position: bottom center;
			}

			.hero-stack img:not(:first-child) {
				position: absolute;
				left: 0;
				bottom: 0;
			}

			.hero-stack img:nth-child(1) {
				position: relative;
				z-index: 1;
			}

			.hero-stack img:nth-child(2) {
				z-index: 2;
			}

			.hero-stack img:nth-child(3) {
				z-index: 3;
			}

			.bottom-section {
				position: relative;
				z-index: 2;
				margin-top: auto;
				width: 100%;
				min-height: clamp(8rem, 30vh, 14rem);
				background-color: #ff0000;
				clip-path: polygon(0 1.75rem, 100% 0, 100% 100%, 0 100%);
			}

			@media (max-width: 640px) {
				.title {
					font-size: clamp(3rem, 12vw + 1rem, 4.5rem);
				}

				.bottom-section {
					clip-path: polygon(0 1.25rem, 100% 0, 100% 100%, 0 100%);
				}
			}
		</style>
	</head>
	<body>
		<div class="title-container">
			<h1 class="title">we have a problem</h1>
		</div>
		<div class="hero-stack">
			<img src="images/l01.png" alt="" />
			<img src="images/l02.png" alt="" />
			<img src="images/l03.png" alt="" />
		</div>
		<section class="bottom-section" aria-hidden="true"></section>
	</body>
</html>
